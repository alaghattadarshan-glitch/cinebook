# Flask Environment
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cinebook-super-secret-key-change-in-production-2025

# Database Configuration
# For MySQL: mysql+pymysql://root:password@localhost:3306/cinebook_db
# For SQLite (default development fallback): sqlite:///cinebook.db
DATABASE_URL=sqlite:///cinebook.db

# TMDB API Configuration (Get your API key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Seat Locking Configuration (in minutes)
SEAT_LOCK_TIMEOUT_MINUTES=10
